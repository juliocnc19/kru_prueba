# Local Docker Compose supplies defaults automatically.
# For Vercel, set both values in project environment settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ENV=production
PLATFORM_ADMIN_EMAIL=owner@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-private-password
# Only for a public technical-test environment; run npm run db:seed once with these.
# SEED_DEMO=true
# DEMO_PASSWORD=replace-with-a-demo-password
